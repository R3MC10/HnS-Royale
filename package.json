{
  "name": "hns-royale",
  "version": "0.2.1",
  "private": true,
  "description": "2D online hack-and-slash royale (browser client + Node server)",
  "author": "HnS Royale",
  "repository": "github:R3MC10/HnS-Royale",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "lobby": "tsx src/lobby/server.ts",
    "start:lobby": "node dist/lobby.js",
    "typecheck": "tsc --noEmit",
    "art": "node scripts/art/import.mjs",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never --config electron-builder.config.cjs",
    "release:win": "npm run build && electron-builder --win --publish always --config electron-builder.config.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "trystero": "^0.26.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.5.13",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "three": "^0.187.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
